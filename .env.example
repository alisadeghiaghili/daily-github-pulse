# Rename this file to .env and fill in your tokens.
# Each token is optional — only needed for the forge you want to search.

# GitHub — https://github.com/settings/tokens
# Required scopes: public_repo (read-only is enough)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# GitLab — https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: read_api
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Gitea / Codeberg — https://codeberg.org/-/user_settings/applications
GITEA_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Bitbucket — https://bitbucket.org/account/settings/app-passwords
# Requires both BITBUCKET_USER and BITBUCKET_APP_PASSWORD
BITBUCKET_USER=your_username
BITBUCKET_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxxxxxx

# AI Filter (optional) — any OpenAI-compatible or Anthropic backend
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
